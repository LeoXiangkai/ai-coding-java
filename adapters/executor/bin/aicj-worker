#!/usr/bin/env python3
"""Run a prompt through an external coding engine inside a linked git worktree. See refs/executor-contract.md."""
from __future__ import annotations

import argparse
import json
import math
import os
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path
from typing import List, Optional

for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8")
    except AttributeError:
        pass


def is_linked_worktree(path: Path) -> bool:
    try:
        git_dir = subprocess.check_output(["git", "rev-parse", "--git-dir"], cwd=path, text=True, encoding="utf-8", stderr=subprocess.DEVNULL).strip()
        common = subprocess.check_output(["git", "rev-parse", "--git-common-dir"], cwd=path, text=True, encoding="utf-8", stderr=subprocess.DEVNULL).strip()
    except (OSError, subprocess.CalledProcessError):
        return False
    def absolute(value: str) -> Path:
        candidate = Path(value.replace("\\", os.sep))
        if not candidate.is_absolute():
            candidate = path / candidate
        return Path(os.path.normcase(os.path.normpath(os.path.realpath(candidate))))

    return absolute(git_dir) != absolute(common)


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="aicj-worker")
    p.add_argument("--cd", required=True)
    p.add_argument("--tier", choices=("high", "mid", "low"), required=True)
    p.add_argument("--engine", choices=("claude", "codex"))
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("prompt")
    return p


def _claude_dir() -> Path:
    # Installed layout is <claude>/bin/aicj-worker; resolve symlinks before walking up.
    return Path(__file__).resolve().parents[2]


def _append_no_proxy(value: str) -> str:
    items = [part.strip() for part in value.split(",") if part.strip()]
    for host in ("127.0.0.1", "localhost"):
        if not any(item.casefold() == host.casefold() for item in items):
            items.append(host)
    return ",".join(items)


def _check_cpa(base_url: str, token: str) -> tuple[bool, str]:
    if not token.strip():
        return False, "AICJ_EXECUTOR_TOKEN 未设置，无法连接 CPA"
    url = base_url.rstrip("/") + "/v1/models"
    request = urllib.request.Request(url, headers={"Authorization": "Bearer " + token.strip()})
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(request, timeout=3) as response:
            if response.status != 200:
                return False, f"CPA 返回 HTTP {response.status}"
    except Exception as exc:
        return False, f"CPA 不可达：{exc}"
    return True, ""


def _child_env(engine: str, base_url: str) -> dict[str, str]:
    result = os.environ.copy()
    if engine != "claude" or not base_url:
        return result
    token = result.get("AICJ_EXECUTOR_TOKEN", "")
    ok, reason = _check_cpa(base_url, token)
    if not ok:
        raise RuntimeError(reason)
    result["ANTHROPIC_BASE_URL"] = base_url.rstrip("/")
    result["ANTHROPIC_AUTH_TOKEN"] = token.strip()
    result.pop("ANTHROPIC_API_KEY", None)
    result.pop("CLAUDECODE", None)
    result.pop("CLAUDE_CODE_ENTRYPOINT", None)
    result["NO_PROXY"] = _append_no_proxy(result.get("NO_PROXY", ""))
    result["no_proxy"] = _append_no_proxy(result.get("no_proxy", ""))
    result["CLAUDE_CONFIG_DIR"] = result.get("AICJ_EXECUTOR_CONFIG_DIR", "").strip() or str(_claude_dir() / "aicj" / "worker-home")
    return result


def main(argv: Optional[List[str]] = None) -> int:
    args = parser().parse_args(argv)
    if not args.prompt.strip():
        print("prompt 不能为空", file=sys.stderr)
        return 2
    worktree = Path(args.cd).expanduser().resolve()
    if not worktree.is_dir() or not is_linked_worktree(worktree):
        print("--cd 必须是 Git linked worktree，不能是主工作区", file=sys.stderr)
        return 2
    engine = args.engine or os.environ.get("AICJ_EXECUTOR_ENGINE", "claude").strip().lower() or "claude"
    if engine not in {"claude", "codex"}:
        print("不支持的外部执行体引擎", file=sys.stderr)
        return 2
    model = os.environ.get(f"AICJ_EXECUTOR_MODEL_{args.tier.upper()}", "").strip()
    prompt = args.prompt
    argv_out: list[str]
    if engine == "claude":
        argv_out = ["claude", "-p", "--dangerously-skip-permissions", "--disallowedTools", "Agent"]
        if model:
            argv_out.extend(["--model", model])
        argv_out.extend(["--", prompt])
    else:
        prompt = prompt.rstrip() + "\n不得再派子代理、不得 commit/push"
        # default read-only sandbox cannot edit files; full access mirrors the claude engine's skipped permissions
        sandbox = os.environ.get("AICJ_EXECUTOR_CODEX_SANDBOX", "").strip() or "danger-full-access"
        effort = {"high": "high", "mid": "medium", "low": "low"}[args.tier]
        argv_out = ["codex", "exec", "--cd", str(worktree), "-s", sandbox, "-c", f'model_reasoning_effort="{effort}"']
        if model:
            argv_out.extend(["-m", model])
        argv_out.append(prompt)
    base_url = os.environ.get("AICJ_EXECUTOR_BASE_URL", "").strip() if engine == "claude" else ""
    raw_timeout = os.environ.get("AICJ_EXECUTOR_TIMEOUT", "").strip()
    timeout = None
    if raw_timeout:
        try:
            timeout = float(raw_timeout)
            if not math.isfinite(timeout) or timeout <= 0:
                raise ValueError
        except ValueError:
            timeout = None
            print("AICJ_EXECUTOR_TIMEOUT 必须是正数秒，已按不限制处理", file=sys.stderr)
    if args.dry_run:
        print(json.dumps(argv_out, ensure_ascii=False))
        if base_url:
            print(f"将使用 AICJ_EXECUTOR_BASE_URL={base_url}", file=sys.stderr)
        return 0
    try:
        child_env = _child_env(engine, base_url)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 69
    if shutil.which(argv_out[0]) is None:
        print("外部执行体不可用，按降级条款改派子代理", file=sys.stderr)
        return 127
    try:
        # Batch files are not directly executable by CreateProcess; invoke them through cmd.exe.
        invocation = argv_out
        stdin_prompt = False
        if os.name == "nt":
            resolved = shutil.which(argv_out[0])
            if resolved and Path(resolved).suffix.casefold() in {".cmd", ".bat"}:
                invocation = [os.environ.get("ComSpec", "cmd.exe"), "/d", "/c", resolved, *argv_out[1:-1]]
                if engine == "claude" and invocation[-1] == "--":
                    invocation.pop()
                elif engine == "codex":
                    invocation.append("-")
                stdin_prompt = True
        # a background caller's stdin is a pipe that never closes; engines would wait on it forever
        proc = subprocess.Popen(invocation, cwd=worktree, env=child_env, stdin=subprocess.PIPE if stdin_prompt else subprocess.DEVNULL)
        try:
            if stdin_prompt:
                proc.communicate(input=prompt.encode("utf-8"), timeout=timeout)
                return proc.returncode
            return proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            # killing cmd.exe alone leaves the engine running; terminate the whole tree on Windows
            if os.name == "nt":
                subprocess.run(["taskkill", "/F", "/T", "/PID", str(proc.pid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            else:
                proc.kill()
            proc.wait()
            raise
    except subprocess.TimeoutExpired:
        print(f"外部执行体超时（AICJ_EXECUTOR_TIMEOUT={raw_timeout}s）", file=sys.stderr)
        return 124
    except OSError:
        print("外部执行体不可用，按降级条款改派子代理", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
