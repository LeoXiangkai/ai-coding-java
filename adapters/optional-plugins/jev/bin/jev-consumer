#!/usr/bin/env python3
"""Recall candidates with git grep and optionally invoke the semantic consumer."""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import re
from pathlib import Path

for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8")
    except AttributeError:
        pass


def fail(message: str, code: int = 2) -> int:
    print(f"jev-consumer: {message}", file=sys.stderr)
    return code


def load_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)", line)
        if not match:
            raise ValueError
        key, value = match.groups()
        if len(value) >= 2 and value[0] in "'\"" and value[-1] == value[0]:
            value = value[1:-1]
        elif value.startswith(("'", '"')) or value.endswith(("'", '"')):
            raise ValueError
        values[key] = value
    return values


def main(argv: list[str] | None = None) -> int:
    args = list(argv or sys.argv[1:])
    if args and args[0] in ("-h", "--help"):
        print('Usage: jev-consumer "<data description>" \'<regex>\' <repo> [--all]')
        return 0
    if len(args) < 3:
        print('Usage: jev-consumer "<data description>" \'<regex>\' <repo> [--all]', file=sys.stderr)
        return 2
    data, pattern, repo = args[:3]
    if not data.strip() or not pattern.strip() or not repo.strip():
        return fail("data description, regex, and repo must be non-blank")
    extra = []
    for option in args[3:]:
        if option == "--all": extra.append(option)
        else: return fail(f"unknown option: {option}")
    if subprocess.run(["git", "-C", repo, "rev-parse", "--show-toplevel"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        return fail(f"not a git repository: {repo}")
    script_path = Path(os.path.abspath(__file__))
    override = os.environ.get("AICJ_CLAUDE_DIR", "")
    claude_dir = Path(override).expanduser() if override.strip() else script_path.parent.parent
    with tempfile.TemporaryDirectory(prefix="jev-consumer-") as temp:
        root = Path(temp)
        listing = root / "list.txt"
        result = subprocess.run(["git", "-C", repo, "grep", "-il", "-E", "--", pattern], capture_output=True, text=True, encoding="utf-8")
        listing.write_text(result.stdout, encoding="utf-8")
        if result.returncode >= 2:
            return fail(f"git grep failed: {result.stderr.strip().splitlines()[-1] if result.stderr.strip() else 'unknown error'}")
        candidates = [line for line in result.stdout.splitlines() if line.strip()]
        if not candidates:
            return fail(f"0 candidate files for /{pattern}/", 1)
        if len(candidates) <= 15:
            print("\n".join(candidates))
            print(f"jev-consumer: {len(candidates)} candidates (<=15) -- read them directly, no semantic call made.", file=sys.stderr)
            return 0
        template = claude_dir / "aicj" / "jev" / "consumer-template.json"
        scan = claude_dir / "skills" / "jev-assist" / "scripts" / "consumer_scan.mjs"
        if not template.is_file(): return fail(f"template missing: {template}")
        if not scan.is_file(): return fail(f"consumer_scan.mjs missing: {scan}")
        node = shutil.which("node")
        if not node: return fail("node command is missing; install node before using the semantic scan")
        child_env = os.environ.copy()
        env_file = os.environ.get("JEV_ENV_FILE")
        if env_file:
            env_path = Path(env_file)
            if not env_path.is_file():
                return fail(f"JEV_ENV_FILE not found: {env_file}")
            try:
                child_env.update(load_env_file(env_path))
            except (OSError, UnicodeError, ValueError):
                return fail(f"failed to load JEV_ENV_FILE: {env_file}")
        spec_path = root / "spec.json"
        try:
            spec = json.loads(template.read_text(encoding="utf-8"))
            if not isinstance(spec, dict): raise ValueError("template must be a JSON object")
            spec.update(data=data.strip(), pattern=pattern.strip())
            spec_path.write_text(json.dumps(spec, ensure_ascii=False), encoding="utf-8")
        except (OSError, ValueError) as exc:
            return fail(f"cannot build spec: {exc}")
        return subprocess.run([node, str(scan), str(spec_path), repo, str(listing), *extra], env=child_env).returncode


if __name__ == "__main__":
    raise SystemExit(main())
