#!/usr/bin/env python3
"""Run git with bounded retries when .git/index.lock is temporarily busy."""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

MAX_RETRY = 10

for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8")
    except AttributeError:
        pass


def real_git() -> str | None:
    self_path = Path(__file__).resolve()
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        candidate = Path(entry) / ("git.exe" if os.name == "nt" else "git")
        try:
            resolved = candidate.resolve()
        except OSError:
            continue
        if candidate.is_file() and os.access(candidate, os.X_OK) and resolved != self_path:
            return str(candidate)
    raw_path = os.environ.get("PATH")
    search_path = os.pathsep.join(entry for entry in raw_path.split(os.pathsep) if entry) if raw_path is not None else None
    found = shutil.which("git", path=search_path)
    return found if found and Path(found).resolve() != self_path else None


def main(argv: list[str] | None = None) -> int:
    executable = real_git()
    if not executable:
        print("git-safe: no real git found on PATH (skipping itself)", file=sys.stderr)
        return 127
    try:
        with tempfile.TemporaryFile(mode="w+b") as buffer:
            for attempt in range(1, MAX_RETRY + 1):
                buffer.seek(0)
                buffer.truncate()
                result = subprocess.run([executable, *(argv or sys.argv[1:])], stdout=sys.stdout, stderr=buffer)
                buffer.seek(0)
                error = buffer.read()
                if result.returncode == 0:
                    sys.stderr.buffer.write(error)
                    return 0
                if result.returncode < 0:
                    sys.stderr.buffer.write(error)
                    return 128 + (-result.returncode)
                text = error.decode("utf-8", errors="replace")
                if "Unable to create" not in text or "index.lock" not in text or "File exists" not in text:
                    sys.stderr.buffer.write(error)
                    return result.returncode
                if attempt < MAX_RETRY:
                    backoff = min(attempt, 5)
                    print(f"[git-safe] index.lock 撞车(第 {attempt}/{MAX_RETRY} 次),{backoff}s 后重试...", file=sys.stderr)
                    time.sleep(backoff)
                else:
                    print(f"[git-safe] index.lock 重试 {MAX_RETRY} 次仍失败,放弃", file=sys.stderr)
                    sys.stderr.buffer.write(error)
                    return result.returncode
    except OSError as exc:
        print(f"git-safe: {exc}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
