        "target": "agents/sa.md"
      },
      {
        "source": "agents/scanner.md",
        "target": "agents/scanner.md"
      }
    ],
    "skills": [
      {
        "source": "skills/add-module",
        "target": "skills/add-module"
      },
      {
        "source": "skills/auto-sdd",
        "target": "skills/auto-sdd"
      },
      {
        "source": "skills/sdd-pipeline",
        "target": "skills/sdd-pipeline"
      }
    ],
    "hooks": [],
